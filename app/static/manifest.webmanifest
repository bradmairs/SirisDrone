{
  "name": "SirisDrone Studio",
  "short_name": "SirisDrone",
  "description": "Edit and export BRM Highlife drone photos and videos",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0e1116",
  "theme_color": "#0e1116",
  "icons": [
    {"src": "/static/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "/static/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"files": [{"name": "files", "accept": ["image/*", "video/*", ".dng", ".DNG", ".srt", ".SRT"]}]}
  },
  "shortcuts": [{"name": "Upload from phone", "url": "/upload", "icons": [{"src": "/static/icon-192.png", "sizes": "192x192"}]}]
}
